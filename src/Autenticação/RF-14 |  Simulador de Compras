!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moneta Go - Simulador de Consumo Consciente</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style-compras.css">
</head>
<body>

    <div class="app-container">
        <header class="main-header">
            <a href="../rf-painel.html" class="logo-link">
                <img src="https://moneta-go.vercel.app/Logo.jpeg" alt="Logo">
                <span class="brand-text"><span class="moneta">MONETA</span><span class="go">GO</span></span>
            </a>
            
            <div class="user-profile-meta">
                <span class="profile-lbl">CONTEXTO DOMÉSTICO</span>
                <span class="user-name">Beatriz (18-25 anos)</span>
            </div>

            <button class="help-button">👁️ AJUDA</button>
        </header>

        <div class="panel-title-strip">
            <h2>Caminho C: Dashboard Adulto / Contexto Doméstico</h2>
            <div class="header-accessibility-note">
                <span>Suporte a Deficientes Visuais</span>
            </div>
        </div>

        <main class="main-content">
            <div class="triple-column-grid">
                
                <div class="grid-column col-left">
                    <div class="section-meta-header">
                        <span class="meta-info-txt">[Total Gasto: R$ 0,00]</span>
                        <span class="meta-info-txt">[Restante: R$ 150,00]</span>
                    </div>

                    <div class="shopping-list-container">
                        <div class="box-head-label">
                            <h4>🛒 Lista de Compras</h4>
                            <small>[Orçamento Disponível: R$ 150,00]</small>
                        </div>
                        
                        <ul class="check-list">
                            <li><input type="checkbox" id="item1"> <label for="item1">Leite (1L)</label></li>
                            <li><input type="checkbox" id="item2"> <label for="item2">Arroz (5kg)</label></li>
                            <li><input type="checkbox" id="item3"> <label for="item3">Feijão (1kg)</label></li>
                            <li><input type="checkbox" id="item4"> <label for="item4">Sabão Pó (1kg)</label></li>
                        </ul>

                        <div class="total-display-card">
                            <span>Gasto Atual:</span>
                            <strong>R$ 138,50</strong>
                        </div>
                    </div>

                    <div class="column-footer-tags">
                        <div class="tag-footer-item">Compras Inteligentes</div>
                    </div>
                </div>

                <div class="grid-column col-center">
                    <div class="challenge-main-box">
                        <div class="box-head-label center-txt">
                            <h3>Desafio do Supermercado Inteligente</h3>
                        </div>

                        <div class="supermarket-shelf">
                            <div class="shelf-row">
                                <div class="product-item">
                                    <span class="prod-icon">🥛</span>
                                    <div class="prod-info">Leite A<br><strong>R$ 5,20</strong></div>
                                    <button class="add-btn">Clique p/ Adicionar</button>
                                </div>
                                <div class="product-item">
                                    <span class="prod-icon">🥛</span>
                                    <div class="prod-info">Leite B<br><strong>R$ 4,80</strong></div>
                                    <button class="add-btn">Clique p/ Adicionar</button>
                                </div>
                            </div>
                            <div class="shelf-divider">Prateleira 1</div>

                            <div class="shelf-row">
                                <div class="product-item">
                                    <span class="prod-icon">🧼</span>
                                    <div class="prod-info">Sabão X<br><strong>R$ 12,00</strong></div>
                                    <button class="add-btn">Clique p/ Adicionar</button>
                                </div>
                                <div class="product-item highlight-economy">
                                    <span class="prod-icon">🧼</span>
                                    <div class="prod-info">Refil Eco<br><strong>R$ 8,50</strong></div>
                                    <button class="add-btn">Clique p/ Adicionar</button>
                                </div>
                            </div>
                            <div class="shelf-divider">Prateleira 2</div>
                        </div>

                        <div class="feedback-result-panel">
                            <div class="result-header">
                                <h4>[Painel de Resumo e Feedback]</h4>
                            </div>
                            <div class="metrics-row">
                                <div class="m-box"><span>Orçamento Total:</span><strong>R$ 150,00</strong></div>
                                <div class="m-box"><span>Valor Gasto:</span><strong class="txt-warn">R$ 138,50</strong></div>
                            </div>
                            <div class="progress-bar-feedback">
                                <span>Progresso da Economia: 92%</span>
                                <div class="bar-bg"><div class="bar-fill" style="width: 92%"></div></div>
                            </div>
                        </div>
                    </div>

